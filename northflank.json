{
  "apiVersion": "v1",
  "spec": {
    "kind": "DeploymentService",
    "spec": {
      "deployment": {
        "instances": 1,
        "storage": {
          "ephemeralStorage": {
            "storageSize": 1024
          }
        }
      },
      "runtimeEnvironment": {
        "NODE_ENV": "production"
      },
      "ports": [
        {
          "name": "web",
          "internalPort": 3000,
          "protocol": "HTTP",
          "public": true,
          "domains": []
        }
      ],
      "buildSettings": {
        "buildpack": {
          "builder": "HEROKU_24",
          "buildpackLocators": [],
          "reuseExistingBuildCache": true
        }
      }
    }
  }
}
